{
  "uid": "graphvisor-ingestion",
  "title": "GraphVisor Ingestion",
  "tags": [
    "graphvisor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "collection",
        "label": "Collection (regex)",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        }
      },
      {
        "name": "doc_id",
        "label": "doc_id (<collection>:<id>)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Collections",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Collections",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap expected [5m]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap done [5m]))",
          "refId": "B",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap failed [5m]))",
          "refId": "C",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap arguments [5m]))",
          "refId": "D",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap entities [5m]))",
          "refId": "E",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap concepts [5m]))",
          "refId": "F",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection, status) (last_over_time({service=\"graphvisor-worker\"} |= \"collection_progress\" | json | collection=~\"$collection\" | unwrap topics [5m]))",
          "refId": "G",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "description": "Latest collection_progress per collection (the worker logs it every minute).",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "expected",
              "Value #B": "done",
              "Value #C": "failed",
              "Value #D": "arguments",
              "Value #E": "entities",
              "Value #F": "concepts",
              "Value #G": "topics"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Collection finalize",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (collection) (max_over_time({service=\"graphvisor-worker\"} |= \"collection_stage\" | json | collection=~\"$collection\" | unwrap stage_code [$__interval]))",
          "refId": "A",
          "legendFormat": "{{collection}}",
          "queryType": "range"
        }
      ],
      "description": "graphvisor_finalize, one row per collection: concepts (LLM), linking, enrichment, topics, hypotheses (LLM), ready.",
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "concept construction",
                  "color": "blue",
                  "index": 0
                },
                "2": {
                  "text": "concept validation",
                  "color": "purple",
                  "index": 1
                },
                "3": {
                  "text": "linking",
                  "color": "orange",
                  "index": 2
                },
                "4": {
                  "text": "metadata",
                  "color": "yellow",
                  "index": 3
                },
                "5": {
                  "text": "citations",
                  "color": "light-blue",
                  "index": 4
                },
                "6": {
                  "text": "map",
                  "color": "light-orange",
                  "index": 5
                },
                "7": {
                  "text": "topics",
                  "color": "red",
                  "index": 6
                },
                "8": {
                  "text": "hypotheses",
                  "color": "dark-purple",
                  "index": 7
                },
                "9": {
                  "text": "ready",
                  "color": "green",
                  "index": 8
                },
                "10": {
                  "text": "failed",
                  "color": "dark-red",
                  "index": 9
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Documents",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Document progress",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (doc_id) (max_over_time({service=\"graphvisor-worker\"} |= \"document_stage\" | json | collection=~\"$collection\" | unwrap stage_code [$__interval]))",
          "refId": "A",
          "legendFormat": "{{doc_id}}",
          "queryType": "range"
        }
      ],
      "description": "One row per document: the stage it is in over time. Hover a segment for its start and duration. L1, classification and L2 are LLM time.",
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "prepare (OCR + chunker)",
                  "color": "blue",
                  "index": 0
                },
                "2": {
                  "text": "abstraction",
                  "color": "purple",
                  "index": 1
                },
                "3": {
                  "text": "L1 extraction",
                  "color": "orange",
                  "index": 2
                },
                "4": {
                  "text": "classification",
                  "color": "yellow",
                  "index": 3
                },
                "5": {
                  "text": "L2 entities",
                  "color": "red",
                  "index": 4
                },
                "6": {
                  "text": "done",
                  "color": "green",
                  "index": 5
                },
                "7": {
                  "text": "failed",
                  "color": "dark-red",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Time per stage (finished documents)",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (doc_id) (last_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" | unwrap prepare_s [$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (doc_id) (last_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" | unwrap abstract_s [$__range]))",
          "refId": "B",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (doc_id) (last_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" | unwrap l1_s [$__range]))",
          "refId": "C",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (doc_id) (last_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" | unwrap classification_s [$__range]))",
          "refId": "D",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (doc_id) (last_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" | unwrap l2_s [$__range]))",
          "refId": "E",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "description": "Seconds per stage, from each document_done event.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "prepare (OCR + chunker)",
              "Value #B": "abstraction",
              "Value #C": "L1 extraction",
              "Value #D": "classification",
              "Value #E": "L2 entities"
            }
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "doc_id",
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 85
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "prepare (OCR + chunker)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "abstraction"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "L1 extraction"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "classification"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "L2 entities"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Documents done / failed",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "count(sum by (doc_id) (count_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" [$__range]))) or vector(0)",
          "refId": "A",
          "legendFormat": "done",
          "queryType": "instant"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "count(sum by (doc_id) (count_over_time({service=\"graphvisor-worker\"} |= \"document_failed\" | json | collection=~\"$collection\" [$__range]))) or vector(0)",
          "refId": "B",
          "legendFormat": "failed",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "done"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "failed"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Average seconds per document",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "avg(avg_over_time({service=\"graphvisor-worker\"} |= \"document_done\" | json | collection=~\"$collection\" | unwrap total_s [$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Model and queues",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pipeline model on GPU",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "min by (model) (last_over_time({service=\"graphvisor-worker\"} |= \"ollama_status\" | json | loaded=\"1\" | unwrap gpu_percent [5m]))",
          "refId": "A",
          "legendFormat": "{{model}}",
          "queryType": "instant"
        }
      ],
      "description": "Share of the loaded model in GPU memory on the pipeline's Ollama. 0% means it runs on the CPU (the container lost its GPU: docker restart it).",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "no model loaded",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker steps per minute",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "sum by (step) (count_over_time({service=\"graphvisor-worker\"} |= \"worker_step\" | json | collection=~\"$collection\" [1m]))",
          "refId": "A",
          "legendFormat": "{{step}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (queue) (last_over_time({service=\"metrics\"} |= \"queue_depth\" | json | queue=~\"graphvisor_.*\" | unwrap messages [2m]))",
          "refId": "A",
          "legendFormat": "{{queue}}",
          "queryType": "range"
        }
      ],
      "description": "From iarag-metrics, which polls every RabbitMQ queue. graphvisor_ingest_dlq holds failed documents."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "graphvisor_ingest consumers",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max(last_over_time({service=\"metrics\"} |= \"queue_depth\" | json | queue=\"graphvisor_ingest\" | unwrap consumers [2m]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "0 means graphvisor_ingest is not published in n8n.",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Shared services: duration per call (our documents)",
      "datasource": {
        "type": "loki",
        "uid": "iarag-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "iarag-loki"
          },
          "expr": "max by (service) (max_over_time({service=~\"ocr|chunker|abstraction-module\"} | json | doc_id=~\"($collection):.*\" | unwrap duration_ms [$__interval]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
