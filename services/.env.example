# Copy to services/.env (gitignored) and fill in. Read by every script in
# services/ and by the worker/graphdb compose files.

# --- n8n (existing shared instance, from IARAG) ---
N8N_CONTAINER=n8n
# Project the workflows are created in (same default as IARAG's sync script).
N8N_PROJECT_ID=mZ2h7wwsbPbyx0MK

# --- RabbitMQ (existing shared instance, from IARAG) ---
# Management API; IARAG serves it under the /rabbitmq path prefix.
RABBITMQ_API_URL=http://localhost:15672/rabbitmq
RABBITMQ_USER=
RABBITMQ_PASS=
# Same vhost as IARAG's RABBITMQ_DEFAULT_VHOST (n8n's "RabbitMQ Credentials" point there).
RABBITMQ_VHOST=

# --- LLM (called from n8n) ---
OLLAMA_MODEL=gemma4:31b
# Id of the n8n credential "GraphVisor Ollama" (Ollama type, Base URL
# http://ollama_high:11434): open it in n8n, the id is the last part of its URL.
# Not IARAG's "Ollama account", which points at ollama_low.
N8N_OLLAMA_CREDENTIAL_ID=

# --- Neo4j (ours: services/graphdb) ---
NEO4J_PASSWORD=

# --- Worker (ours: services/worker) ---
# Address n8n uses to reach the worker on n8n-net.
WORKER_URL=http://graphvisor-worker:8000
VECTORIZER_URL=http://vectorizer:8089/embed
OPENALEX_MAILTO=
# The pipeline's Ollama (same as the credential above): the worker logs which
# models are loaded there and how much is on the GPU (dashboard).
OLLAMA_STATUS_URL=http://ollama_high:11434

# --- Grafana (IARAG's, services/observability): sync-to-grafana.sh pushes the dashboard ---
GRAFANA_URL=http://127.0.0.1:8030/logs
GRAFANA_USER=admin
GRAFANA_PASSWORD=
