    {
      "parameters": {
        "jsCode": "// The abstraction service takes form lists (chunk_list=..&chunk_list=..), as\n// the old pipeline sent them with requests; n8n's form fields are fixed, so\n// the urlencoded body is built here.\nconst sc = $('Save chunks').first().json;\nconst enc = (k, v) => encodeURIComponent(k) + '=' + encodeURIComponent(v ?? '');\nconst parts = [\n  ...sc.chunk_list.map(c => enc('chunk_list', c)),\n  ...sc.chunk_title.map(t => enc('chunk_title', t)),\n  enc('doc_id', sc.collection + ':' + sc.id),\n];\nreturn [{ json: { form: parts.join('&') } }];"
      },
      "id": "6e10ffea-5af4-5d40-8e3c-0e8872e1f903",
      "name": "Abstraction form",
